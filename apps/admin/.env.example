# Admin app env (apps/admin). All VITE_* are PUBLIC and ship in the bundle.
# NEVER put the Supabase service_role key here — admin accounts are provisioned
# server-side (dashboard / service_role), never from the browser.

# Supabase project (same project as the game). Anon/publishable key only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Origin of the FastAPI backend serving GET /admin/me (the admin gate probe).
VITE_ADMIN_API_ENDPOINT=http://localhost:8000

# Cloudflare Turnstile site key. Supabase CAPTCHA is project-global, so admin
# password login needs this when CAPTCHA is enabled on the hosted project. Unset →
# no widget (fine locally where CAPTCHA is off).
VITE_TURNSTILE_SITE_KEY=
