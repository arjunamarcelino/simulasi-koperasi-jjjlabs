# apps/backend — salin ke `.env` (gitignored), lalu isi kredensial. Dua proses
# berbagi file ini: token server (api/server.py) + voice worker
# (voice_worker/voice_agent.py). Di deployment, set var yang sama sebagai env host.
# JANGAN commit `.env` yang terisi (kredensial rahasia).

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://<subdomain>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Nama dispatch agent — worker & token harus memakai nama yang sama.
LIVEKIT_AGENT_NAME=koperasi-agent

# --- Azure OpenAI (dialog NPC — gpt-5-mini) ---
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-01-preview
# Nama DEPLOYMENT di Azure (bukan nama model). Dialog + observer drift pakai ini.
AZURE_OPENAI_DEPLOYMENT_DIALOGUE=gpt-5-mini
# Deployment model canggih untuk AI Auditor (PRD: gpt-5.4). Dipakai Skenario 2+.
AZURE_OPENAI_DEPLOYMENT_AUDITOR=gpt-5.4

# --- Azure Speech (STT & TTS) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2

# --- FastAPI / CORS ---
# Origin FE yang diizinkan (comma-split). Lokal = Vite dev (game :5173 + admin :5174);
# produksi = origin FE ter-deploy. FE mengirim header `Authorization: Bearer` ke /token
# dan GET /admin/me (request preflighted); server mengizinkan header `Authorization` +
# `OPTIONS` + method GET/POST. Origin ini BUKAN kontrol auth — JWT-lah gerbangnya.
# CORS_ALLOW_ORIGINS diutamakan; CORS_ALLOW_ORIGIN (singular, lama) tetap didukung
# sebagai fallback agar deploy game lama tak rusak (SIM-14).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Supabase JWT verification (SIM-4) ---
# /token memverifikasi JWT Supabase dari FE SEBELUM mint token LiveKit: tanda
# tangan via JWKS (ES256 SAJA — `alg` token tak pernah dipilih dari header), cek
# `exp`/`aud`=authenticated/`iss`. Guest (`is_anonymous`) ditandai di metadata;
# penolakan reward guest ditegakkan oleh RLS Postgres, bukan endpoint ini. Nilai
# di bawah PUBLIC (bukan rahasia). Proyek live SIM-40:
SUPABASE_JWKS_URL=https://ntyojhksnciusyaehxhj.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://ntyojhksnciusyaehxhj.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated

# --- Rate limit /token (SIM-4, mitigasi H1) — opsional, ada default ---
# Batas per-user (sub): TOKEN_RATE_CAPACITY permintaan per TOKEN_RATE_WINDOW_SEC detik.
# TOKEN_RATE_CAPACITY=10
# TOKEN_RATE_WINDOW_SEC=60

# --- Admin metrics DB (SIM-15) — SATU-SATUNYA jalur DB backend, fail-soft ---
# GET /admin/metrics connect sebagai role least-privilege `metrics_reader` (EXECUTE-only,
# BUKAN service_role) untuk memanggil admin.metrics_overview(). Kosong → endpoint 503
# (fail-soft; /token + /health tetap jalan). JANGAN commit nilai berisi password.
# Lokal (supabase start, tanpa TLS):
#   METRICS_DB_URL=postgresql://metrics_reader:<pw-lokal>@127.0.0.1:54322/postgres
#   METRICS_DB_SSL=disable
# Hosted (Supabase SESSION pooler — username WAJIB `metrics_reader.<project-ref>`, :5432,
# host dari dialog Connect; nama role polos → "FATAL: Tenant or user not found"):
#   METRICS_DB_URL=postgresql://metrics_reader.<project-ref>:<url-safe-secret>@aws-<idx>-<region>.pooler.supabase.com:5432/postgres
#   METRICS_DB_SSL=verify-full   # verify-full memakai CA sistem (cukup untuk pooler Supabase)
METRICS_DB_URL=
METRICS_DB_SSL=verify-full
