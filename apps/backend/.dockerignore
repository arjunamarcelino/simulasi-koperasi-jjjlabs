# Jangan salin ke image: venv (platform-specific), VCS, cache, dan — PENTING —
# file .env berisi kredensial. COPY . /app akan membawa apa pun yang tak di-ignore.
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Semua varian .env (kredensial) KECUALI contoh non-rahasia.
.env
.env.*
!.env.example
# Build artefak & dokumen
dist/
build/
*.md
tests/
.cache/
