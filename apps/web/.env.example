# Voice-session transport: "mock" (default, no backend) or "livekit".
# With no .env at all the app runs in mock mode (scripted conversation, offline).
VITE_TRANSPORT=mock

# Only used when VITE_TRANSPORT=livekit — the backend POST /token endpoint
# (apps/backend/api/server.py). Leave empty in mock mode.
# For local dev with the backend running: http://localhost:8000
VITE_TOKEN_ENDPOINT=

# --- Supabase (SIM-3 auth; provisioned by SIM-1) ---
# Both are PUBLIC by design (they ship in the client bundle). The anon key is an
# RLS-bounded key, not a secret. NEVER put the service_role key here or anywhere
# in the frontend. With these unset, the app boots in a degraded no-auth mode.
# Values come from the Supabase dashboard: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
